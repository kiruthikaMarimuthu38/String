import java.util.*;
public class Main
{
    public static void main(String[] args)
    {
        String str = "HeLLo";
        for(int i = 0; i < str.length(); i++)
        {
            char ch = str.charAt(i);
            if(ch >= 'A' && ch <= 'Z')
            {
                System.out.print((char)(ch + 32));
            }
            else
            {
                System.out.print((char)(ch - 32));
            }
        }
    }
}
