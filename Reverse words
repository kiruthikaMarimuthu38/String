import java.util.*;
public class Main
{
    public static void main(String[] args)
    {
        String str = "I Love Java";
        String arr[] = str.split(" ");
        for(int i = 0; i < arr.length; i++)
        {
            String word = arr[i];
            for(int j = word.length()-1; j >= 0; j--)
            {
                System.out.print(word.charAt(j));
            }
            System.out.print(" ");
        }
    }
}
